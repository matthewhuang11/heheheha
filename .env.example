# Copy to .env. Everything is optional. Never commit .env.
# Gemini scene and talk access. Without it, scenes use the configured fake/sim provider and talk falls back to Ollama or canned replies. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model for scene descriptions. Leave the default unless you have measured another model.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional Gemini model just for survivor replies and fact extraction. Empty uses GEMINI_MODEL.
GEMINI_TALK_MODEL=
# ElevenLabs cloud voice. Without it, Scoutbot uses the configured local offline voice. Get a key at https://elevenlabs.io/
ELEVENLABS_API_KEY=
# Optional ElevenLabs voice ID. Empty uses ElevenLabs' stock voice.
ELEVENLABS_VOICE_ID=
# Optional MongoDB Atlas survivor sync. Without it, MongoDB sync stays disabled. Get a URI at https://www.mongodb.com/atlas
MONGODB_URI=
# Optional Tiger Data (Postgres/Timescale) survivor sync. Without it, Tiger sync stays disabled. Get a URI at https://www.tigerdata.com/
TIGER_DATABASE_URL=
# Optional camera index. Empty lets Scoutbot auto-detect a camera.
CAMERA_INDEX=
# Optional dashboard bearer token. Empty leaves the local dashboard without login protection.
SCOUTBOT_TOKEN=
