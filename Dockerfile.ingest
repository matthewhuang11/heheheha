FROM python:3.13-slim

WORKDIR /app
RUN useradd --create-home --uid 10001 scoutbot
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY scoutbot ./scoutbot
USER scoutbot
EXPOSE 8080
CMD ["uvicorn", "scoutbot.ingest.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
